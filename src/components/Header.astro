---
import Wordmark from './Wordmark.astro';
const base = (import.meta.env.BASE_URL as string).replace(/\/+$/, '') + '/';
const path = Astro.url.pathname.replace(/\/+$/, '') + '/';
const links = [
  { href: base, key: 'nav_match', label: 'Match' },
  { href: base + 'programs/', key: 'nav_programs', label: 'Programs' },
  { href: base + 'faculty/', key: 'nav_faculty', label: 'Faculty' },
  { href: base + 'shortlist/', key: 'nav_shortlist', label: 'Shortlist', count: true },
  { href: base + 'about/', key: 'nav_about', label: 'About' },
];
const isCurrent = (href: string) => (href === base ? path === base : path.startsWith(href));
---
<header class="site-header">
  <div class="shell">
    <Wordmark />
    <nav class="nav" id="site-nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}><span data-i18n={l.key}>{l.label}</span>{l.count && <span class="count" id="shortlist-count"></span>}</a>
      ))}
    </nav>
    <div class="header-tools">
      <button type="button" class="lang-btn" id="lang-toggle" data-i18n="lang_toggle" aria-label="Switch language">中文</button>
      <button type="button" class="icon-btn" id="theme-toggle" data-i18n="theme_toggle" data-i18n-attr="aria-label" aria-label="Toggle dark mode">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <button type="button" class="icon-btn menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="site-nav" data-i18n="menu" data-i18n-attr="aria-label" aria-label="Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>
<style>
  :root[data-theme="dark"] .sun, .moon { display: none; }
  :root[data-theme="dark"] .moon { display: block; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .sun { display: none; } :root:not([data-theme="light"]) .moon { display: block; } }
</style>
<script>
  import { initLang, setLang, getLang } from '../lib/i18n';
  import { count } from '../lib/shortlist';
  initLang();
  const root = document.documentElement;
  const themeBtn = document.getElementById('theme-toggle')!;
  themeBtn.addEventListener('click', () => {
    const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    document.dispatchEvent(new CustomEvent('themechange', { detail: next }));
  });
  document.getElementById('lang-toggle')!.addEventListener('click', () => setLang(getLang() === 'en' ? 'zh' : 'en'));
  const menu = document.getElementById('menu-toggle')!, nav = document.getElementById('site-nav')!;
  menu.addEventListener('click', () => { const open = nav.dataset.open !== 'true'; nav.dataset.open = String(open); menu.setAttribute('aria-expanded', String(open)); });
  const updateCount = () => { const el = document.getElementById('shortlist-count'); if (el) el.textContent = count() ? String(count()) : ''; };
  updateCount();
  document.addEventListener('shortlistchange', updateCount);
</script>
