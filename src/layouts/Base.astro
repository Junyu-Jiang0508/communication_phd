---
import '../styles/global.css';
import Header from '../components/Header.astro';
import meta from '../data/meta.json';
interface Props { title?: string; description?: string; wide?: boolean }
const { title = 'Communication PhD Explorer', description = 'Find US Communication, media and journalism PhD programs and faculty that match your research. Matching runs in your browser.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const fullTitle = title === 'Communication PhD Explorer' ? title : `${title} · Communication PhD Explorer`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <script is:inline>
      (function () { try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; var l = localStorage.getItem('lang'); if (l === 'zh') document.documentElement.lang = 'zh'; } catch (e) {} })();
    </script>
  </head>
  <body>
    <Header />
    <main class="shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">
        <span>Communication PhD Explorer · data built {meta.built} · <a href={`${base}about/`}>methods, sources and limits</a></span>
        <span>Made by <a href="https://junyuj.com" rel="noreferrer">Junyu Jiang</a> · <a href="https://github.com/Junyu-Jiang0508/communication_phd" rel="noreferrer">source</a> · inspired by the Political Science Program Explorer</span>
      </div>
    </footer>
  </body>
</html>
